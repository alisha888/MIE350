  "searchKey": "",
  "tableData": "{{\n  Project.data.filter(project => {\n    // 1. Filter by Active User\n    const isUserProject = project.userId == appsmith.store.userId;\n\n    // 2. Filter by Skills (If dropdown is empty, show all projects for that user)\n    const matchesSkills = SkillsDropdown.selectedOptionValues.length === 0 || \n                          project.skillIds.some(id => SkillsDropdown.selectedOptionValues.includes(id));\n\n    return isUserProject && matchesSkills;\n  })\n}}",
